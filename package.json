{
  "name": "@zthun/janitor",
  "version": "0.0.0",
  "description": "Style checks with tools for web projects using common rules.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/janitor"
  },
  "private": true,
  "scripts": {
    "clean": "rimraf --glob 'packages/**/dist' 'packages/**/docs' 'reports' 'coverage' 'packages/**/*.tgz'",
    "test": "vitest --run --coverage",
    "lint": "tsx packages/lint-janitor/src/cli.ts",
    "build": "lerna run build",
    "make": "yarn clean && yarn lint && yarn test && yarn build",
    "postinstall": "husky install"
  },
  "author": "Anthony Bonta",
  "devDependencies": {
    "@commitlint/cli": "^19.4.1",
    "@commitlint/config-conventional": "^19.4.1",
    "@types/eslint": "^8.56.12",
    "@types/estree": "^1.0.5",
    "@types/glob": "^8.1.0",
    "@types/htmlhint": "^1.1.5",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.17.7",
    "@types/node": "^22.5.2",
    "@types/prettier": "^3.0.0",
    "@types/yargs": "^17.0.33",
    "@vitest/coverage-istanbul": "^2.0.5",
    "@zthun/lint-janitor": "^17.0.0",
    "@zthun/lint-janitor-config": "^17.0.0",
    "husky": "^9.1.5",
    "lerna": "^8.1.8",
    "react": "^18.3.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "yarn@4.4.1"
}
