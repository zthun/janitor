{
  "name": "@zthun/janitor",
  "version": "0.0.0",
  "description": "Style checks with tools for web projects using common rules.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/janitor"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf --glob 'packages/**/dist' 'packages/**/docs' 'reports' 'coverage' 'packages/**/*.tgz'",
    "check": "tsc --noEmit",
    "test": "vitest --run --coverage",
    "lint": "tsx packages/janitor-lint/src/cli.mts",
    "build": "lerna run build",
    "make": "yarn clean && yarn build && yarn check && yarn lint && yarn test",
    "postinstall": "husky install"
  },
  "author": "Anthony Bonta",
  "devDependencies": {
    "@commitlint/cli": "^20.4.0",
    "@commitlint/config-conventional": "^20.4.0",
    "@types/eslint": "^9.6.1",
    "@types/estree": "^1.0.8",
    "@types/htmlhint": "^1.1.5",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.1.0",
    "@types/yargs": "^17.0.35",
    "@vitest/coverage-v8": "^4.0.18",
    "@zthun/janitor-lint": "*",
    "@zthun/janitor-lint-config": "*",
    "husky": "^9.1.7",
    "lerna": "9.0.3",
    "react": "^19.2.4",
    "rimraf": "^6.1.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  },
  "optionalDependencies": {
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "yarn@4.12.0"
}
