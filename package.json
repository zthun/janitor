{
  "name": "@zthun/janitor",
  "version": "0.0.0",
  "description": "Style checks with tools for web projects using common rules.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/janitor"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf --glob 'packages/**/dist' 'packages/**/docs' 'reports' 'coverage' 'packages/**/*.tgz'",
    "check": "tsc --noEmit",
    "test": "vitest --run --coverage",
    "lint": "eslint",
    "build": "lerna run build",
    "make": "yarn clean && yarn check && yarn lint && yarn test && yarn build"
  },
  "author": "Anthony Bonta",
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-angular": "^21.2.0",
    "@types/eslint": "^9.6.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "lerna": "10.0.0",
    "react": "^19.2.8",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "yarn@4.18.0"
}
