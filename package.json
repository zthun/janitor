{
  "name": "@zthun/janitor",
  "version": "0.0.0",
  "description": "Style checks with tools for web projects using common rules.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/janitor"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf --glob 'packages/**/dist' 'packages/**/docs' 'reports' 'coverage' 'packages/**/*.tgz'",
    "check": "tsc --noEmit",
    "test": "vitest --run --coverage",
    "lint": "tsx packages/lint-janitor/src/cli.ts",
    "build": "lerna run build",
    "make": "yarn clean && yarn build && yarn check && yarn lint && yarn test",
    "postinstall": "husky install"
  },
  "author": "Anthony Bonta",
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/eslint": "^9.6.1",
    "@types/estree": "^1.0.7",
    "@types/glob": "^8.1.0",
    "@types/htmlhint": "^1.1.5",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.15.19",
    "@types/prettier": "^3.0.0",
    "@types/yargs": "^17.0.33",
    "@vitest/coverage-istanbul": "^2.1.9",
    "@zthun/lint-janitor": "*",
    "@zthun/lint-janitor-config": "*",
    "husky": "^9.1.7",
    "lerna": "^8.2.2",
    "react": "^19.1.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.4",
    "typescript": "~5.7.3",
    "vite": "^5.4.19",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-external": "^4.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.9"
  },
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "yarn@4.6.0"
}
