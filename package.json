{
  "name": "@zthun/janitor",
  "version": "0.0.0",
  "description": "Style checks with tools for web projects using common rules.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/janitor"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf --glob 'packages/**/dist' 'packages/**/docs' 'reports' 'coverage' 'packages/**/*.tgz'",
    "check": "tsc --noEmit",
    "test": "vitest --run --coverage",
    "lint": "eslint",
    "build": "lerna run build",
    "make": "yarn clean && yarn check && yarn lint && yarn test && yarn build",
    "postinstall": "husky install"
  },
  "author": "Anthony Bonta",
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@types/eslint": "^9.6.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "lerna": "9.0.7",
    "react": "^19.2.6",
    "rimraf": "^6.1.3",
    "tsx": "^4.22.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "yarn@4.14.1"
}
