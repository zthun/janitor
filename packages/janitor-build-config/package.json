{
  "name": "@zthun/janitor-build-config",
  "version": "19.3.4",
  "description": "A shared configuration for builds that create websites, apis, and tests",
  "type": "module",
  "types": "./dist/index.d.mts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    "./vite": {
      "types": "./dist/vite/index.d.mts",
      "require": "./dist/vite.cjs",
      "import": "./dist/vite.js"
    },
    "./typedoc": {
      "types": "./dist/typedoc/index.d.mts",
      "require": "./dist/typedoc.cjs",
      "import": "./dist/typedoc.js"
    }
  },
  "scripts": {
    "build": "vite build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/janitor",
    "directory": "packages/janitor-lint-config"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@swc/core": "^1.13.5",
    "@vitejs/plugin-react": "^5.0.2",
    "lodash-es": "^4.17.21",
    "typedoc": "^0.28.12",
    "unplugin-swc": "^1.5.7",
    "vite": "^7.1.5",
    "vite-plugin-checker": "^0.10.3",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "devDependencies": {
    "typescript": "~5.9.2"
  },
  "peerDependencies": {
    "typedoc": ">=0.28.5 <1.0.0",
    "vite": ">=6.0.0 <8.0.0",
    "vitest": ">=3.2.0 <4.0.0"
  },
  "peerDependenciesMeta": {
    "typedoc": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Anthony Bonta"
}
