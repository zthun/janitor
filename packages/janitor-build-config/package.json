{
  "name": "@zthun/janitor-build-config",
  "version": "18.1.0",
  "description": "A shared configuration for builds that create websites, apis, and tests",
  "type": "module",
  "types": "./dist/index.d.mts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    "./test": {
      "types": "./dist/html/htmlhint.d.mts",
      "require": "./dist/htmlhint.cjs",
      "import": "./dist/htmlhint.js"
    },
    "./library": {
      "types": "./dist/markdown/markdownlint.d.mts",
      "require": "./dist/markdownlint.cjs",
      "import": "./dist/markdownlint.js"
    }
  },
  "scripts": {
    "build": "vite build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/janitor",
    "directory": "packages/janitor-lint-config"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "lodash-es": "^4.17.21",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-externalize-deps": "^0.9.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.1.4"
  },
  "devDependencies": {
    "typescript": "~5.8.3"
  },
  "peerDependencies": {
    "vite": ">=5.0.0 <6.0.0",
    "vitest": ">=3.0.0 <4.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Anthony Bonta"
}
