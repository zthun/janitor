{
  "name": "@zthun/janitor-build-config",
  "version": "20.0.0",
  "description": "A shared configuration for builds that create websites, apis, and tests",
  "type": "module",
  "types": "./dist/index.d.mts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    "./vite": {
      "types": "./dist/vite/index.d.mts",
      "require": "./dist/vite.cjs",
      "import": "./dist/vite.js"
    },
    "./typedoc": {
      "types": "./dist/typedoc/index.d.mts",
      "require": "./dist/typedoc.cjs",
      "import": "./dist/typedoc.js"
    }
  },
  "scripts": {
    "build": "vite build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/janitor",
    "directory": "packages/janitor-build-config"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@swc/core": "^1.15.21",
    "@vitejs/plugin-react": "^6.0.1",
    "lodash-es": "^4.17.23",
    "typedoc": "^0.28.18",
    "unplugin-swc": "^1.5.9",
    "vite": "^8.0.3",
    "vite-plugin-checker": "^0.12.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.2"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  },
  "peerDependencies": {
    "typedoc": ">=0.28.5 <1.0.0",
    "vite": ">=8 <9",
    "vitest": ">=4 <5"
  },
  "peerDependenciesMeta": {
    "typedoc": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Anthony Bonta"
}
