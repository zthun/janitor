{
  "name": "@zthun/lint-janitor-config",
  "version": "18.0.2",
  "description": "A shared configuration for lint janitor for @zthun scoped projects.",
  "keywords": [
    "eslint",
    "eslint-config",
    "htmlhint",
    "htmlhint-config",
    "markdownlint",
    "markdownlint-config",
    "prettier",
    "prettier-config"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./eslint": {
      "require": "./dist/eslint.cjs",
      "import": "./dist/eslint.js",
      "types": "./dist/es/eslint.d.mts"
    },
    "./htmlhint": {
      "require": "./dist/htmlhint.cjs",
      "import": "./dist/htmlhint.js",
      "types": "./dist/html/htmlhint.d.mts"
    },
    "./markdownlint": {
      "require": "./dist/markdownlint.cjs",
      "import": "./dist/markdownlint.js",
      "types": "./dist/markdown/markdownlint.d.mts"
    },
    "./prettier": {
      "require": "./dist/prettier.cjs",
      "import": "./dist/prettier.js",
      "types": "./dist/pretty/prettier.d.mts"
    },
    "./stylelint": {
      "require": "./dist/stylelint.cjs",
      "import": "./dist/stylelint.js",
      "types": "./dist/style/stylelint.d.mts"
    },
    "./stylelint/less": {
      "require": "./dist/stylelint-less.cjs",
      "import": "./dist/stylelint-less.js",
      "types": "./dist/style/stylelint-less.d.mts"
    },
    "./stylelint/sass": {
      "require": "./dist/stylelint-sass.cjs",
      "import": "./dist/stylelint-sass.js",
      "types": "./dist/style/stylelint-sass.d.mts"
    }
  },
  "scripts": {
    "build": "vite build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/janitor",
    "directory": "packages/lint-janitor-config"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@zthun/eslint-config": "^18.0.1",
    "@zthun/htmlhint-config": "^18.0.1",
    "@zthun/markdownlint-config": "^18.0.1",
    "@zthun/prettier-config": "^18.0.1",
    "@zthun/stylelint-config": "^18.0.1",
    "@zthun/stylelint-config-less": "^18.0.1",
    "@zthun/stylelint-config-sass": "^18.0.1",
    "eslint": "^9.14.0",
    "htmlhint": "^1.1.4",
    "markdownlint": "~0.36.1",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "stylelint": "^16.10.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-dts": "^4.3.0",
    "vite-plugin-externalize-deps": "^0.8.0",
    "vite-tsconfig-paths": "^5.1.0"
  },
  "peerDependencies": {
    "@zthun/lint-janitor": ">=16.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Anthony Bonta"
}
