{
  "name": "@zthun/janitor-lint-config",
  "version": "19.0.0",
  "description": "A shared configuration for janitor lint for @zthun scoped projects.",
  "keywords": [
    "eslint",
    "eslint-config",
    "htmlhint",
    "htmlhint-config",
    "markdownlint",
    "markdownlint-config",
    "prettier",
    "prettier-config"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    },
    "./eslint": {
      "types": "./dist/es/eslint.d.mts",
      "require": "./dist/eslint.cjs",
      "import": "./dist/eslint.js"
    },
    "./htmlhint": {
      "types": "./dist/html/htmlhint.d.mts",
      "require": "./dist/htmlhint.cjs",
      "import": "./dist/htmlhint.js"
    },
    "./markdownlint": {
      "types": "./dist/markdown/markdownlint.d.mts",
      "require": "./dist/markdownlint.cjs",
      "import": "./dist/markdownlint.js"
    },
    "./prettier": {
      "types": "./dist/pretty/prettier.d.mts",
      "require": "./dist/prettier.cjs",
      "import": "./dist/prettier.js"
    },
    "./stylelint": {
      "types": "./dist/style/stylelint.d.mts",
      "require": "./dist/stylelint.cjs",
      "import": "./dist/stylelint.js"
    },
    "./stylelint/less": {
      "types": "./dist/style/stylelint-less.d.mts",
      "require": "./dist/stylelint-less.cjs",
      "import": "./dist/stylelint-less.js"
    },
    "./stylelint/sass": {
      "types": "./dist/style/stylelint-sass.d.mts",
      "require": "./dist/stylelint-sass.cjs",
      "import": "./dist/stylelint-sass.js"
    }
  },
  "scripts": {
    "build": "vite build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/janitor",
    "directory": "packages/janitor-lint-config"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@zthun/janitor-eslint-config": "^19.0.0",
    "@zthun/janitor-htmlhint-config": "^19.0.0",
    "@zthun/janitor-markdownlint-config": "^19.0.0",
    "@zthun/janitor-prettier-config": "^19.0.0",
    "@zthun/janitor-stylelint-config": "^19.0.0",
    "@zthun/janitor-stylelint-config-less": "^19.0.0",
    "@zthun/janitor-stylelint-config-sass": "^19.0.0",
    "eslint": "^9.28.0",
    "htmlhint": "^1.5.1",
    "markdownlint": "~0.38.0",
    "postcss": "^8.5.4",
    "prettier": "^3.5.3",
    "stylelint": "^16.20.0"
  },
  "devDependencies": {
    "@zthun/janitor-build-config": "^19.0.0",
    "@zthun/janitor-lint": "^19.0.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-externalize-deps": "^0.9.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "peerDependencies": {
    "@zthun/janitor-lint": ">=19.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Anthony Bonta"
}
