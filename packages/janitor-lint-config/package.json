{
  "name": "@zthun/janitor-lint-config",
  "version": "19.5.6",
  "description": "A shared configuration for janitor lint for @zthun scoped projects.",
  "keywords": [
    "eslint",
    "eslint-config",
    "prettier",
    "prettier-config"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    },
    "./eslint": {
      "types": "./dist/es/eslint.d.mts",
      "require": "./dist/eslint.cjs",
      "import": "./dist/eslint.js"
    },
    "./prettier": {
      "types": "./dist/pretty/prettier.d.mts",
      "require": "./dist/prettier.cjs",
      "import": "./dist/prettier.js"
    },
    "./stylelint": {
      "types": "./dist/style/stylelint.d.mts",
      "require": "./dist/stylelint.cjs",
      "import": "./dist/stylelint.js"
    },
    "./stylelint/less": {
      "types": "./dist/style/stylelint-less.d.mts",
      "require": "./dist/stylelint-less.cjs",
      "import": "./dist/stylelint-less.js"
    },
    "./stylelint/sass": {
      "types": "./dist/style/stylelint-sass.d.mts",
      "require": "./dist/stylelint-sass.cjs",
      "import": "./dist/stylelint-sass.js"
    }
  },
  "scripts": {
    "build": "vite build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/janitor",
    "directory": "packages/janitor-lint-config"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@zthun/janitor-eslint-config": "^19.5.6",
    "@zthun/janitor-prettier-config": "^19.5.6",
    "@zthun/janitor-stylelint-config": "^19.5.6",
    "@zthun/janitor-stylelint-config-less": "^19.5.6",
    "@zthun/janitor-stylelint-config-sass": "^19.5.6",
    "eslint": "^9.39.4",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "stylelint": "^16.26.1"
  },
  "devDependencies": {
    "@zthun/janitor-build-config": "^19.5.6",
    "@zthun/janitor-lint": "^19.5.6",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  },
  "peerDependencies": {
    "@zthun/janitor-lint": ">=19.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Anthony Bonta"
}
